<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      ┌──────────────────────────────────────────────────────────┐
      │ 权限说明 —— 只申请真正必要的，多余的一个都不要              │
      └──────────────────────────────────────────────────────────┘
    -->

    <!-- 读取媒体：仅在需要时申请（相册选图若用 PickVisualMedia 则无需） -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- 保存到相册 -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <!-- 网络：AI 生成 + 图库检索。不联网时这些功能不可用，其余功能完全离线 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      所有文件访问权限 —— 「自动读取账号与表情」的前提。

      Android 11+ 起，Android/data/ 目录（QQ 和微信的表情都放这里）
      默认对第三方 App 完全不可见。只有拿到这个权限，才能自动遍历
      文件系统找到账号目录，而不需要用户手动一个个点系统选择器。

      注意：这是高敏感权限，上架 Google Play 会被拒。
      本工具自用、不上架，所以可用 —— 这一点在设置页也对用户讲明了。
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- 批量任务完成后通知（可选） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      唤起微信 / QQ：Android 11+ 需要声明包可见性，
      否则 getLaunchIntentForPackage 会返回 null。
    -->
    <queries>
        <package android:name="com.tencent.mm" />
        <package android:name="com.tencent.mobileqq" />
    </queries>

    <application
        android:name=".StickerFerryApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StickerFerry"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.StickerFerry"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
