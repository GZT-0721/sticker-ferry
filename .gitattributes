# 默认：文本文件统一用 LF 换行
# 这是给 Linux（GitHub Actions）准备的，避免 CRLF 把 shell 脚本搞坏
* text=auto eol=lf

# Windows 批处理必须用 CRLF，否则 cmd 解析会出错
*.bat text eol=crlf
*.cmd text eol=crlf

# shell 脚本和 workflow 强制 LF
gradlew text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 二进制文件不做换行转换
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.webp binary
*.ttf binary
*.otf binary
